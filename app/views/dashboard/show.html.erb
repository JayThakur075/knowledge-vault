<section class="hero"><p class="eyebrow">YOUR PERSONAL KNOWLEDGE BASE</p><h1>Keep what you learn.</h1><p>Save technical notes, code, troubleshooting fixes, and useful resources in one searchable place.</p><%= link_to "Create a note", new_note_path, class: "button" %> <%= link_to "Browse notes", notes_path %></section>
<div class="stats"><div class="stat"><strong><%= @note_count %></strong><span>Notes</span></div><div class="stat"><strong><%= @category_count %></strong><span>Categories</span></div><div class="stat"><strong><%= @tag_count %></strong><span>Tags</span></div><div class="stat"><strong><%= @favorite_count %></strong><span>Favorites</span></div></div>
<% if @stale_note_count %><p class="flash notice">Weekly review: <%= pluralize(@stale_note_count, "note") %> have not been updated in the past 30 days.</p><% end %>
<div class="section-heading"><h2>Recently updated</h2><%= link_to "All notes", notes_path %></div>
<% if @recent_notes.any? %><% @recent_notes.each do |note| %><article class="card compact"><h3><%= link_to note.title, note_path(note) %></h3><p><%= truncate(note.content.to_s, length: 120) %></p><div class="meta"><%= note.note_type.titleize %> · <%= l(note.updated_at, format: :short) %></div></article><% end %><% else %><div class="empty-state"><p>Your vault is ready for its first note.</p><%= link_to "Create your first note", new_note_path, class: "button" %></div><% end %>
<% if @notes_by_type.any? %><h2>Notes by type</h2><p class="meta"><%= @notes_by_type.map { |type, count| "#{type.titleize}: #{count}" }.join(" · ") %></p><% end %>
