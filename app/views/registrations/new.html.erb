<section class="auth-card">
<p class="eyebrow">START YOUR PERSONAL KNOWLEDGE BASE</p>
<h1>Create your account</h1>
<p class="muted">Save useful things you learn and find them again when you need them.</p>

<%= form_with model: @user, url: sign_up_path do |form| %>
  <% if @user.errors.any? %>
    <div>
      <h3>Please correct the following errors:</h3>

      <ul>
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :email_address, "Email" %>
    <%= form.email_field :email_address, required: true, autocomplete: "email" %>
  </div>

  <div>
    <%= form.label :password %>
    <%= form.password_field :password, required: true, autocomplete: "new-password" %>
  </div>

  <div>
    <%= form.label :password_confirmation, "Confirm password" %>
    <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password" %>
  </div>

  <div>
    <%= form.submit "Create account", class: "button button-primary" %>
  </div>
<% end %>

<p>
  Already have an account? <%= link_to "Sign in", new_session_path %>
</p>
</section>
