<h1><%= @link.title %></h1><p><%= link_to @link.safe_url, @link.safe_url, target: "_blank", rel: "noopener noreferrer" if @link.safe_url %></p><p><%= @link.description %></p><p>Category: <%= @link.category&.name || "Uncategorized" %></p><h2>Tags</h2><%= @link.tags.map(&:name).join(", ") %><p><%= link_to "Edit", edit_link_path(@link) %> · <%= link_to "Back to links", links_path %></p>
