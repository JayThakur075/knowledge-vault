<h1>Saved links</h1><p class="muted">Keep useful development resources close at hand.</p>
<%= form_with url: links_path, method: :get, class: "filters" do |f| %><div><%= f.label :query, "Search links" %><%= f.search_field :query, value: params[:query] %></div><div><%= f.label :category_id, "Category" %><%= f.select :category_id, options_from_collection_for_select(Current.user.categories.order(:name), :id, :name, params[:category_id]), include_blank: "All categories" %></div><div><%= f.label :tag, "Tag" %><%= f.select :tag, options_from_collection_for_select(Current.user.tags.order(:name), :name, :name, params[:tag]), include_blank: "All tags" %></div><%= f.submit "Search", class: "button" %><%= link_to "Clear", links_path %><% end %>
<div class="section-heading"><h2>Resources</h2><%= link_to "Add link", new_link_path, class: "button" %></div>
<% if @links.any? %><% @links.each do |link| %><article class="card"><h2><%= link_to link.title, link_path(link) %></h2><p><%= link_to link.safe_url, link.safe_url, target: "_blank", rel: "noopener noreferrer" if link.safe_url %></p><p><%= link.description %></p><div class="meta"><%= link.category&.name || "Uncategorized" %></div><div class="tags"><% link.tags.each do |tag| %><%= link_to "##{tag.name}", links_path(request.query_parameters.merge(tag: tag.name)), class: "tag" %><% end %></div><div class="actions"><%= link_to "Edit", edit_link_path(link), class: "button button-secondary button-small" %><%= button_to "Delete", link_path(link), method: :delete, form: { data: { turbo_confirm: "Delete this saved link?" } }, class: "button-danger" %></div></article><% end %><% else %><div class="empty-state"><p>No saved links found.</p><%= link_to "Add your first link", new_link_path, class: "button" %></div><% end %>
