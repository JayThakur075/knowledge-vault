<%= form_with model: @note do |form| %>
  <% if @note.errors.any? %>
    <div>
      <h3><%= pluralize(@note.errors.count, "error") %> prevented this note from being saved:</h3>

      <ul>
        <% @note.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title %>
    <%= form.text_field :title, required: true %>
  </div>

  <div>
    <%= form.label :note_type %>
    <%= form.select :note_type,
      ["ruby", "rails", "javascript", "sql", "troubleshooting"],
      { include_blank: "Select a type" },
      required: true %>
  </div>

  <div>
    <%= form.label :content %>
    <%= form.text_area :content, rows: 12 %>
  </div>

  <div>
    <%= form.label :favorite %>
    <%= form.check_box :favorite %>
  </div>

  <div>
    <%= form.label :category_id, "Category" %>

    <%= form.collection_select(
      :category_id,
      Current.user.categories.order(:name),
      :id,
      :name,
      { include_blank: "No category" }
    ) %>
  </div>

  <div>
    <%= label_tag :tag_names, "Tags (comma-separated)" %>

    <%= text_field_tag :tag_names,
      @note.tags.map(&:name).join(", "),
      placeholder: "performance, security, interview-prep" %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>