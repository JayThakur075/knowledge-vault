<h1>Knowledge Vault</h1>

<p>Your personal library of technical knowledge.</p>

<%= link_to "Create New Note", new_note_path %>

<% if @notes.any? %>
  <% @notes.each do |note| %>
    <article>
      <h2><%= link_to note.title, note_path(note) %></h2>

      <p>Type: <%= note.note_type %></p>

      <% if note.favorite? %>
        <p>⭐ Favorite</p>
      <% end %>

      <p>
        <%= truncate(note.content.to_s, length: 150) %>
      </p>

      <%= link_to "Edit", edit_note_path(note) %>

      <%= button_to "Delete",
        note_path(note),
        method: :delete,
        form: {
          data: {
            turbo_confirm: "Are you sure you want to delete this note?"
          }
        } %>
    </article>

    <hr>
  <% end %>
<% else %>
  <p>You haven't created any notes yet.</p>
  <p>Create your first note to get started!</p>
<% end %>