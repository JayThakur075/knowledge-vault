<h1>Your Notes</h1>
<p class="muted">A searchable home for your technical knowledge.</p>

<%= form_with url: notes_path, method: :get, class: "filters" do |form| %>
  <div><%= form.label :query, "Search notes and tags" %><%= form.search_field :query, value: params[:query], placeholder: "Title, content, or tag" %></div>
  <div><%= form.label :note_type, "Type" %><%= form.select :note_type, options_for_select([["All types", ""], *@note_types.map { |type| [type.titleize, type] }], params[:note_type]) %></div>
  <div><%= form.label :category_id, "Category" %><%= form.select :category_id, options_from_collection_for_select(@categories, :id, :name, params[:category_id]), include_blank: "All categories" %></div>
  <div><%= form.label :tag, "Tag" %><%= form.select :tag, options_from_collection_for_select(@tags, :name, :name, params[:tag]), include_blank: "All tags" %></div>
  <div class="check"><%= form.check_box :favorite, { checked: params[:favorite] == "true" }, "true", "false" %><%= form.label :favorite, "Favorites only" %></div>
  <%= form.submit "Apply filters", class: "button" %><%= link_to "Clear filters", notes_path %>
<% end %>

<div class="section-heading"><h2>Notes</h2><%= link_to "New note", new_note_path, class: "button" %></div>
<% if @notes.any? %>
  <% @notes.each do |note| %>
    <article class="card">
      <div class="section-heading"><h2><%= link_to note.title, note_path(note) %></h2><span class="badge"><%= note.note_type.titleize %></span></div>
      <p><%= truncate(note.content.to_s, length: 180) %></p>
      <div class="meta"><%= "★ Favorite · " if note.favorite? %><%= note.category&.name || "Uncategorized" %> · Updated <%= l(note.updated_at, format: :short) %></div>
      <div class="tags"><% note.tags.each do |tag| %><%= link_to "##{tag.name}", notes_path(request.query_parameters.merge(tag: tag.name, page: nil)), class: "tag" %><% end %></div>
      <div class="actions"><%= link_to "Edit", edit_note_path(note) %><%= button_to "Delete", note_path(note), method: :delete, form: { data: { turbo_confirm: "Delete this note?" } }, class: "link-button" %></div>
    </article>
  <% end %>
  <% if @total_pages > 1 %><nav class="pagination" aria-label="Pagination"><%= link_to "← Previous", notes_path(request.query_parameters.merge(page: @page - 1)), class: (@page == 1 ? "disabled" : nil) unless @page == 1 %><span>Page <%= @page %> of <%= @total_pages %></span><%= link_to "Next →", notes_path(request.query_parameters.merge(page: @page + 1)) unless @page == @total_pages %></nav><% end %>
<% else %>
  <div class="empty-state"><h2>No notes match these filters</h2><p>Try clearing your filters or save your first note.</p><%= link_to "Create a note", new_note_path, class: "button" %></div>
<% end %>
