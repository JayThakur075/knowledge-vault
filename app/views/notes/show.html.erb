<h1><%= @note.title %></h1>

<p>
  <strong>Type:</strong>
  <%= @note.note_type %>
</p>

<p>
  <strong>Favorite:</strong>
  <%= @note.favorite? ? "Yes" : "No" %>
</p>

<h2>Content</h2>

<pre><%= @note.content %></pre>

<%= link_to "Edit", edit_note_path(@note) %>
<%= link_to "Back to Notes", notes_path %>