<article class="note-detail">
  <header class="note-detail-header">
    <div class="note-heading">
      <p class="eyebrow">TECHNICAL NOTE</p>
      <h1><%= @note.title %></h1>
      <div class="note-meta">
        <span class="badge"><%= @note.note_type.titleize %></span>
        <% if @note.favorite? %><span class="favorite-badge">★ Favorite</span><% end %>
        <span><%= @note.category&.name || "Uncategorized" %></span>
      </div>
    </div>
    <nav class="note-actions" aria-label="Note actions">
      <%= link_to "← Back to notes", notes_path, class: "button button-secondary" %>
      <%= link_to "Edit note", edit_note_path(@note), class: "button" %>
    </nav>
  </header>

  <section class="note-content-section">
    <div class="note-section-heading">
      <h2>Content</h2>
      <span class="meta">Updated <%= l(@note.updated_at, format: :long) %></span>
    </div>
    <pre class="note-content"><%= @note.content.presence || "No content added." %></pre>
  </section>

  <section class="note-tags-section" aria-labelledby="note-tags-heading">
    <h2 id="note-tags-heading">Tags</h2>
    <% if @note.tags.any? %>
      <div class="tags">
        <% @note.tags.each do |tag| %>
          <%= link_to tag.name, notes_path(tag: tag.name), class: "tag" %>
        <% end %>
      </div>
    <% else %>
      <p class="muted">No tags added yet.</p>
    <% end %>
  </section>

  <footer class="note-detail-footer">
    <span class="meta">Created <%= l(@note.created_at, format: :long) %></span>
    <%= link_to "← Back to notes", notes_path, class: "text-link" %>
  </footer>
</article>
